// Cloudflare Workers configuration (free plan).
// Static files from dist/ are served by Cloudflare; worker/index.js only handles /api/* and /healthz.
// Secrets (RESEND_API_KEY) are NOT here: set them in the dashboard (Worker > Settings > Variables and Secrets).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dar-zayna",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "build": {
    // Generates dist/ before every deploy and every local `wrangler dev`.
    "command": "node frontend/build.js"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get the nearest 404.html: /ar/... gets the Arabic one.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  // Approximate per-visitor limit for the contact form, per Cloudflare location.
  // Cloudflare only offers periods of 10 or 60 seconds.
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  // Keep variables set in the dashboard when deploying (secrets are always kept).
  "keep_vars": true,
  "observability": { "enabled": true }
}
