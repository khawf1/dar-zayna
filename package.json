{
  "name": "dar-zayna",
  "version": "1.0.0",
  "description": "Trilingual (FR/AR/EN) website for a Moroccan restaurant, with a secure Node.js contact form.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node frontend/build.js",
    "start": "node --env-file-if-exists=.env backend/server.js",
    "dev": "npm run build && node --env-file-if-exists=.env --watch-path=backend backend/server.js",
    "test": "npm run test:backend && npm run test:e2e",
    "test:backend": "node --test \"tests/backend/**/*.test.js\"",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0"
  }
}
