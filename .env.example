# Copy this file to .env and fill it in. Never commit .env.

# Port the server listens on. Hosting platforms usually set this for you.
PORT=3000

# Email for the contact form (https://resend.com, free tier).
# Without all three, the form tells visitors that sending is unavailable.
RESEND_API_KEY=re_your_api_key_here
# Where contact messages are delivered (the restaurant's inbox).
CONTACT_TO_EMAIL=owner@example.com
# Sender. Must be on a domain verified in Resend. For a first test without a domain,
# Resend allows "onboarding@resend.dev", but then only to the address of your Resend account.
CONTACT_FROM_EMAIL=Dar Zayna <contact@your-domain.com>

# Set to 1 when the app runs behind one proxy (Render, Railway, Fly.io...),
# so rate limiting sees the visitor's real IP address.
TRUST_PROXY=false

# Optional: contact form limit per IP address (default 5 messages per 15 minutes).
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MINUTES=15

# Used at build time for canonical links, hreflang and social previews.
SITE_URL=http://localhost:3000
